{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block content %}
    <div class="container py-5">
        <div class="row justify-content-center text-center">
            <div class="col-12 col-md-8">
                {% if error is not null %}
                    <h1 class="h3 text-danger">{{ 'setono_sylius_abandoned_cart.ui.unsubscribe_error_title'|trans }}</h1>
                    <p class="text-muted">{{ error|trans }}</p>
                {% else %}
                    <h1 class="h3 text-success">{{ 'setono_sylius_abandoned_cart.ui.successfully_unsubscribed'|trans }}</h1>
                    <p class="text-muted">{{ 'setono_sylius_abandoned_cart.ui.unsubscribe_confirmation'|trans }}</p>
                {% endif %}

                <a href="{{ path('sylius_shop_homepage') }}" class="btn btn-primary btn-lg mt-3">
                    {{ 'setono_sylius_abandoned_cart.ui.back_to_store'|trans }}
                </a>
            </div>
        </div>
    </div>
{% endblock %}
